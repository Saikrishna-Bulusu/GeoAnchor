# Live mode: where the API on the board is.
# Leave unset when the dashboard is served BY that API (same origin) -- the
# default is then window.location, which is what you want on the Jetson.
NEXT_PUBLIC_GEOANCHOR_API=http://192.168.1.50:8000

# Vercel builds have no board to reach, so they start in replay mode and read
# a session.json the user drops in or a file placed in public/.
NEXT_PUBLIC_GEOANCHOR_MODE=replay
